# Copy this file to .env before local or Docker Compose startup.
# Do not write real secrets into files committed to Git.

APP_NAME=enterprise-document-qa-agent
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=
LOG_LEVEL=INFO

EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_PRELOAD=true
EMBEDDING_LOCAL_FILES_ONLY=true

LLM_TIMEOUT=30
QWEN_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

DOCUMENT_DB_PATH=data/documents.db
CHROMA_DIR=chroma_db
UPLOAD_DIR=uploads
LOG_DIR=logs

API_BASE_URL=http://127.0.0.1:8000

# If DASHSCOPE_API_KEY is empty, the project keeps local parsing/retrieval
# available and uses the existing fallback or explicit error handling for LLM
# generation according to the current service logic.
# In docker-compose, the web service overrides API_BASE_URL as http://api:8000.
