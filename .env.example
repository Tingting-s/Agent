# Copy this file to .env before local or Docker Compose startup.
# Do not write real secrets into files committed to Git.

APP_NAME=enterprise-document-qa-agent
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=
LOG_LEVEL=INFO

EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_PRELOAD=true
EMBEDDING_LOCAL_FILES_ONLY=true

LLM_TIMEOUT=30
QWEN_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

DOCUMENT_DB_PATH=data/documents.db
CHROMA_DIR=chroma_db
UPLOAD_DIR=uploads
LOG_DIR=logs
MAX_ASYNC_UPLOAD_SIZE_MB=20

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=5
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=960
CELERY_RESULT_EXPIRES=86400
CELERY_VISIBILITY_TIMEOUT=3600
CHROMA_WRITE_LOCK_TIMEOUT_SECONDS=900

API_BASE_URL=http://127.0.0.1:8000

# Docker Compose only. The host paths keep runtime data outside containers.
UPLOADS_HOST_PATH=./uploads
DATA_HOST_PATH=./data
CHROMA_HOST_PATH=./chroma_db
LOGS_HOST_PATH=./logs
DOCKER_EMBEDDING_DEVICE=cpu
DOCKER_EMBEDDING_LOCAL_FILES_ONLY=false

# If DASHSCOPE_API_KEY is empty, the project keeps local parsing/retrieval
# available and uses the existing fallback or explicit error handling for LLM
# generation according to the current service logic.
# In docker-compose, the web service overrides API_BASE_URL as http://api:8000.
